{
 "perc_out": "\\hat{y} = \\mathbf{1}\\!\\left[\\, w^{\\top}x + b > 0 \\,\\right]",
 "perc_rule": "w \\leftarrow w + \\eta\\,(y - \\hat{y})\\,x",
 "mlp": "\\hat{y} = \\sigma\\!\\big(W_2\\,\\sigma(W_1 x + b_1) + b_2\\big)",
 "xor": "\\mathrm{XOR}(x_1, x_2) = \\mathrm{AND}\\big(\\mathrm{OR}(x_1, x_2),\\ \\mathrm{NAND}(x_1, x_2)\\big)",
 "backprop": "\\delta^{(l)} = \\big(W^{(l+1)\\top}\\,\\delta^{(l+1)}\\big) \\odot f'\\big(z^{(l)}\\big)",
 "chainrule": "\\frac{\\partial L}{\\partial W^{(l)}} = \\delta^{(l)}\\, a^{(l-1)\\top}",
 "sigmoid": "\\sigma(x) = \\frac{1}{1 + e^{-x}}",
 "dsigmoid": "\\sigma'(x) = \\sigma(x)\\,\\big(1 - \\sigma(x)\\big) \\le \\tfrac{1}{4}",
 "vanish": "\\frac{\\partial L}{\\partial x_1} = \\frac{\\partial L}{\\partial x_n} \\prod_{k=1}^{n-1} \\sigma'(z_k)\\, w_k",
 "relu": "\\mathrm{ReLU}(x) = \\max(0,\\, x)",
 "hog": "\\lVert \\nabla I \\rVert = \\sqrt{I_x^2 + I_y^2}, \\qquad \\theta = \\arctan \\frac{I_y}{I_x}",
 "sift": "D(x, y, \\sigma) = \\big(G(x, y, k\\sigma) - G(x, y, \\sigma)\\big) * I(x, y)",
 "conv": "(I * K)(i, j) = \\sum_{m} \\sum_{n} I(i + m,\\, j + n)\\, K(m, n)",
 "convlayer": "h^{(l)} = \\mathrm{ReLU}\\big(W^{(l)} * h^{(l-1)} + b^{(l)}\\big)",
 "sgd": "\\theta \\leftarrow \\theta - \\eta\\, \\nabla_{\\theta}\\, \\frac{1}{B} \\sum_{i=1}^{B} L\\big(f_{\\theta}(x_i),\\, y_i\\big)",
 "svm_primal": "\\min_{w,\\, b}\\ \\tfrac{1}{2} \\lVert w \\rVert^2 \\quad \\text{s.t.} \\quad y_i\\,(w^{\\top} x_i + b) \\ge 1",
 "svm_dual": "\\max_{\\alpha}\\ \\sum_{i} \\alpha_i - \\tfrac{1}{2} \\sum_{i, j} \\alpha_i \\alpha_j\\, y_i y_j\\, K(x_i, x_j)",
 "rbf": "K(x, x') = \\exp\\!\\big(-\\gamma\\, \\lVert x - x' \\rVert^2\\big)",
 "margin": "\\gamma = \\frac{2}{\\lVert w \\rVert}",
 "kerneltrick": "K(x, x') = \\big\\langle \\phi(x),\\, \\phi(x') \\big\\rangle",
 "resnet": "y = \\mathcal{F}\\big(x, \\{W_i\\}\\big) + x",
 "batchnorm": "\\hat{x} = \\frac{x - \\mu_{\\mathcal{B}}}{\\sqrt{\\sigma_{\\mathcal{B}}^2 + \\epsilon}}, \\qquad y = \\gamma \\hat{x} + \\beta",
 "ngram": "P(w_t \\mid w_{t-2}, w_{t-1}) = \\frac{C(w_{t-2}, w_{t-1}, w_t)}{C(w_{t-2}, w_{t-1})}",
 "rnn": "h_t = \\tanh\\big(W_{hh}\\, h_{t-1} + W_{xh}\\, x_t + b\\big)",
 "bptt": "\\frac{\\partial h_t}{\\partial h_k} = \\prod_{i=k+1}^{t} W_{hh}^{\\top}\\, \\mathrm{diag}\\big(\\tanh'(a_i)\\big)",
 "lstm_f": "f_t = \\sigma\\big(W_f\\, [h_{t-1}, x_t] + b_f\\big)",
 "lstm_i": "i_t = \\sigma\\big(W_i\\, [h_{t-1}, x_t] + b_i\\big)",
 "lstm_c": "c_t = f_t \\odot c_{t-1} + i_t \\odot \\tilde{c}_t",
 "lstm_h": "h_t = o_t \\odot \\tanh(c_t)",
 "seq2seq": "p(y \\mid x) = \\prod_{t=1}^{T'} p\\big(y_t \\mid y_{<t},\\, c\\big)",
 "bahdanau_e": "e_{ij} = v^{\\top} \\tanh\\big(W s_{i-1} + U h_j\\big)",
 "bahdanau_a": "\\alpha_{ij} = \\frac{\\exp(e_{ij})}{\\sum_{k} \\exp(e_{ik})}, \\qquad c_i = \\sum_{j} \\alpha_{ij}\\, h_j",
 "attention": "\\mathrm{Attention}(Q, K, V) = \\mathrm{softmax}\\!\\left(\\frac{Q K^{\\top}}{\\sqrt{d_k}}\\right) V",
 "multihead": "\\mathrm{MultiHead}(Q, K, V) = \\mathrm{Concat}(\\mathrm{head}_1, \\dots, \\mathrm{head}_h)\\, W^{O}",
 "head": "\\mathrm{head}_i = \\mathrm{Attention}\\big(Q W_i^{Q},\\, K W_i^{K},\\, V W_i^{V}\\big)",
 "posenc": "PE_{(pos,\\, 2i)} = \\sin\\!\\big(pos \\,/\\, 10000^{2i / d_{\\mathrm{model}}}\\big)",
 "ffn": "\\mathrm{FFN}(x) = \\max(0,\\, x W_1 + b_1)\\, W_2 + b_2",
 "layernorm": "x \\leftarrow \\mathrm{LayerNorm}\\big(x + \\mathrm{Sublayer}(x)\\big)",
 "gan": "\\min_{G} \\max_{D}\\ \\mathbb{E}_{x \\sim p_{\\mathrm{data}}}\\big[\\log D(x)\\big] + \\mathbb{E}_{z \\sim p_z}\\big[\\log\\big(1 - D(G(z))\\big)\\big]",
 "ddpm_fwd": "x_t = \\sqrt{\\bar{\\alpha}_t}\\, x_0 + \\sqrt{1 - \\bar{\\alpha}_t}\\, \\epsilon, \\qquad \\epsilon \\sim \\mathcal{N}(0, I)",
 "ddpm_loss": "L = \\mathbb{E}_{t,\\, x_0,\\, \\epsilon} \\Big[ \\big\\lVert \\epsilon - \\epsilon_{\\theta}(x_t, t) \\big\\rVert^2 \\Big]",
 "rope": "f(x_m, m) = R^{d}_{\\Theta, m}\\, W x_m, \\qquad \\theta_i = 10000^{-2i/d}",
 "rope_rot": "\\begin{pmatrix} \\cos m\\theta_i & -\\sin m\\theta_i \\\\ \\sin m\\theta_i & \\cos m\\theta_i \\end{pmatrix}",
 "rmsnorm": "\\bar{x}_i = \\frac{x_i}{\\mathrm{RMS}(x)}\\, g_i, \\qquad \\mathrm{RMS}(x) = \\sqrt{\\tfrac{1}{n} \\textstyle\\sum_{i=1}^{n} x_i^2}",
 "swiglu": "\\mathrm{SwiGLU}(x) = \\big(\\mathrm{Swish}(x W) \\odot x V\\big)\\, W_2",
 "moe": "y = \\sum_{i=1}^{n} G(x)_i\\, E_i(x), \\qquad G(x) = \\mathrm{Softmax}\\big(\\mathrm{TopK}(x W_g,\\, k)\\big)",
 "quant": "q = \\mathrm{clamp}\\big(\\mathrm{round}(x / s) + z,\\ 0,\\ 15\\big), \\qquad \\hat{x} = s\\,(q - z)",
 "lora": "h = W_0 x + \\Delta W x = W_0 x + B A x, \\qquad r \\ll \\min(d, k)",
 "icl": "\\hat{y} = \\arg\\max_{y}\\ p_{\\theta}\\big(y \\mid (x_1, y_1), \\dots, (x_k, y_k),\\, x\\big)",
 "mlm": "\\mathcal{L}_{\\mathrm{MLM}} = -\\sum_{i \\in \\mathcal{M}} \\log p_{\\theta}\\big(x_i \\mid x_{\\setminus \\mathcal{M}}\\big)",
 "clm": "\\mathcal{L} = -\\sum_{t=1}^{T} \\log p_{\\theta}\\big(x_t \\mid x_{<t}\\big)",
 "causal": "\\mathrm{softmax}\\!\\left(\\frac{Q K^{\\top}}{\\sqrt{d_k}} + M\\right) V, \\qquad M_{ij} = \\begin{cases} 0 & j \\le i \\\\ -\\infty & j > i \\end{cases}",
 "scaling": "L(N) = \\left(\\frac{N_c}{N}\\right)^{\\alpha_N}",
 "chinchilla": "L(N, D) = E + \\frac{A}{N^{\\alpha}} + \\frac{B}{D^{\\beta}}",
 "compute": "C \\approx 6\\, N D",
 "params": "N \\approx 12\\, n_{\\mathrm{layer}}\\, d_{\\mathrm{model}}^{2}",
 "bt": "P(y_w \\succ y_l \\mid x) = \\sigma\\big(r(x, y_w) - r(x, y_l)\\big)",
 "rlhf": "\\max_{\\pi_{\\theta}}\\ \\mathbb{E}\\big[r(x, y)\\big] - \\beta\\, D_{\\mathrm{KL}}\\big(\\pi_{\\theta}(y \\mid x)\\, \\Vert\\, \\pi_{\\mathrm{ref}}(y \\mid x)\\big)",
 "dpo": "\\mathcal{L}_{\\mathrm{DPO}} = -\\mathbb{E}\\left[\\log \\sigma\\!\\left(\\beta \\log \\frac{\\pi_{\\theta}(y_w \\mid x)}{\\pi_{\\mathrm{ref}}(y_w \\mid x)} - \\beta \\log \\frac{\\pi_{\\theta}(y_l \\mid x)}{\\pi_{\\mathrm{ref}}(y_l \\mid x)}\\right)\\right]",
 "flash_m": "m^{(j)} = \\max\\big(m^{(j-1)},\\ \\mathrm{rowmax}(S^{(j)})\\big)",
 "flash_l": "\\ell^{(j)} = e^{\\,m^{(j-1)} - m^{(j)}}\\, \\ell^{(j-1)} + \\mathrm{rowsum}\\big(e^{\\,S^{(j)} - m^{(j)}}\\big)",
 "flash_io": "\\Theta\\!\\left(\\frac{N^2 d^2}{M}\\right) \\ \\text{HBM accesses} \\quad \\text{vs.} \\quad \\Theta\\big(N d + N^2\\big)",
 "ppl": "\\mathrm{PPL} = \\exp\\!\\Big(-\\frac{1}{N} \\sum_{i=1}^{N} \\log p(x_i \\mid x_{<i})\\Big)",
 "alibi": "\\mathrm{softmax}\\big(q_i K^{\\top} + m \\cdot [-(i-1), \\dots, -1, 0]\\big)",
 "posinterp": "f'(x, m) = f\\!\\left(x,\\, \\frac{m L}{L'}\\right)",
 "quad": "\\mathcal{O}(n^2 d) \\ \\text{time}, \\qquad \\mathcal{O}(n^2) \\ \\text{memory}",
 "linattn": "V'_i = \\frac{\\phi(Q_i)^{\\top} \\sum_{j} \\phi(K_j)\\, V_j^{\\top}}{\\phi(Q_i)^{\\top} \\sum_{j} \\phi(K_j)}",
 "ssm": "h_t = \\bar{A}\\, h_{t-1} + \\bar{B}\\, x_t, \\qquad y_t = C\\, h_t, \\qquad \\bar{A} = \\exp(\\Delta A)",
 "top5": "\\text{top-5 err} = \\frac{1}{N} \\sum_{i=1}^{N} \\mathbf{1}\\big[\\, y_i \\notin \\mathrm{top}_5\\, f(x_i) \\,\\big]",
 "bleu": "\\mathrm{BLEU} = \\mathrm{BP} \\cdot \\exp\\!\\Big(\\sum_{n=1}^{4} w_n \\log p_n\\Big)",
 "lambada": "\\mathrm{acc} = \\frac{1}{N} \\sum_{i=1}^{N} \\mathbf{1}\\big[\\arg\\max_{w}\\ p(w \\mid c_i) = w_i\\big]"
}